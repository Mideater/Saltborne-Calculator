  "saltborneTemplate": {
    "mods": {
      "STR": 2
    },
    "ecl": 1,
    "ep": 150,
    "verified": true,
    "traits": [
      "Applied on top of a non-EP base race (Human, any Half-Elf, Half-Orc, Moon Elf, Shield Dwarf, Rock Gnome, or Lightfoot Halfling) \u2014 keeps that race's stats/traits plus this",
      "Cannot combine with a picked subrace's own bonuses (e.g. 'Saltborne Sun Elf' only gets Moon Elf base stats + Saltborne)",
      "Skill Affinity: Survival",
      "Subrace power: Crushing Deluge 1/day",
      "5/- Negative Energy damage reduction"
    ],
    "notes": "STR capped at 20 at creation. Flavor text implies an additional mental malus but it's not numerically confirmed \u2014 check in-game before assuming a penalty exists. Only selectable on subraces flagged saltborneEligible:true \u2014 applying it uses the BASE subrace's stats plus these, never a picked subrace's own special bonuses (e.g. picking 'Saltborne' over Sun Elf still only gives you Moon Elf's stats, not Sun Elf's)."
  }
}